; kalka per-user installer (spec 23.1). Generated by tools/release from
; kalka.nsi.tmpl; uses only what ships with NSIS (MUI2, LogicLib, nsExec).
Unicode true
!include "MUI2.nsh"
!include "LogicLib.nsh"
!include "Sections.nsh"

!define PRODUCT "kalka"
!define VERSION "[[.Version]]"
!define UNINST_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\[[.AppID]]"
!define WV2_CLIENT "Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
; PATH is changed by `kalka path`, never here: an NSIS string holds 1024
; characters, and a longer PATH read into one comes back cut short.
!define PATH_BY_HAND "kalka could not be added to your PATH, which was left as it is. Add $INSTDIR to it yourself to use kalka in a terminal."

Name "${PRODUCT} ${VERSION}"
OutFile "[[.Out]]"
InstallDir "$LOCALAPPDATA\Programs\${PRODUCT}"
InstallDirRegKey HKCU "${UNINST_KEY}" "InstallLocation"
RequestExecutionLevel user
SetCompressor /SOLID lzma
ShowInstDetails show
ShowUninstDetails show

!define MUI_FINISHPAGE_RUN "$INSTDIR\kalka-desktop.exe"
!define MUI_FINISHPAGE_RUN_TEXT "Start kalka"
; The sample blueprints, to try kalka with (spec 23.1). The checkbox
; slot MUI calls "show readme" runs AddSamples.
!define MUI_FINISHPAGE_SHOWREADME ""
!define MUI_FINISHPAGE_SHOWREADME_TEXT "Add sample blueprints to Personal, to try kalka with"
!define MUI_FINISHPAGE_SHOWREADME_FUNCTION AddSamples
; The plugins are components: each is optional, and the choice is kept
; in the uninstall key (Plugin.<scheme>, 1 or 0) for the next install,
; a silent update included.
!define MUI_COMPONENTSPAGE_TEXT_TOP "Plugins link blueprints to issue trackers. Leave out the ones you do not use; run the installer again to add or remove one."
!insertmacro MUI_PAGE_COMPONENTS
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "English"

Section "kalka" SecCore
  SectionIn RO
  ; An upgrade: stop the running kalka (and its window) so the files can
  ; be replaced. Running rounds finish first.
  ${If} ${FileExists} "$INSTDIR\kalka.exe"
    DetailPrint "Stopping the running kalka"
    nsExec::Exec '"$INSTDIR\kalka.exe" stop --wait 30s'
    Pop $0
  ${EndIf}
  ; A silent install is kalka updating itself (spec 24.3): the old
  ; kalka-desktop.exe that started it is still ending, so wait until its
  ; file can be removed (at most 15 seconds).
  ${If} ${Silent}
  ${AndIf} ${FileExists} "$INSTDIR\kalka-desktop.exe"
    StrCpy $1 0
    waitfree:
      ClearErrors
      Delete "$INSTDIR\kalka-desktop.exe"
      ${IfNot} ${FileExists} "$INSTDIR\kalka-desktop.exe"
        Goto freed
      ${EndIf}
      IntOp $1 $1 + 1
      ${If} $1 < 30
        Sleep 500
        Goto waitfree
      ${EndIf}
    freed:
  ${EndIf}

  SetOutPath "$INSTDIR"
  File "[[.Src]]/kalka.exe"
  File "[[.Src]]/kalka-desktop.exe"
  File "[[.Src]]/README.txt"
  WriteUninstaller "$INSTDIR\uninstall.exe"

  CreateShortcut "$SMPROGRAMS\kalka.lnk" "$INSTDIR\kalka-desktop.exe" "" "$INSTDIR\kalka-desktop.exe" 0

  WriteRegStr HKCU "${UNINST_KEY}" "DisplayName" "kalka"
  WriteRegStr HKCU "${UNINST_KEY}" "DisplayVersion" "${VERSION}"
  WriteRegStr HKCU "${UNINST_KEY}" "Publisher" "kalka"
  WriteRegStr HKCU "${UNINST_KEY}" "InstallLocation" "$INSTDIR"
  WriteRegStr HKCU "${UNINST_KEY}" "DisplayIcon" "$INSTDIR\kalka-desktop.exe"
  WriteRegStr HKCU "${UNINST_KEY}" "UninstallString" '"$INSTDIR\uninstall.exe"'
  WriteRegDWORD HKCU "${UNINST_KEY}" "NoModify" 1
  WriteRegDWORD HKCU "${UNINST_KEY}" "NoRepair" 1

  ; The kalka:// scheme for join links, per user (spec 23.1a). The shell
  ; re-checks it at start.
  WriteRegStr HKCU "Software\Classes\kalka" "" "URL:kalka join link"
  WriteRegStr HKCU "Software\Classes\kalka" "URL Protocol" ""
  WriteRegStr HKCU "Software\Classes\kalka\DefaultIcon" "" '"$INSTDIR\kalka-desktop.exe",0'
  WriteRegStr HKCU "Software\Classes\kalka\shell\open\command" "" '"$INSTDIR\kalka-desktop.exe" "%1"'
SectionEnd

SectionGroup /e "Plugins" SecPlugins
  Section "GitHub" SecGh
    SetOutPath "$INSTDIR"
    File "[[.Src]]/kalka-plugin-gh.exe"
  SectionEnd
  Section "Jira" SecJira
    SetOutPath "$INSTDIR"
    File "[[.Src]]/kalka-plugin-jira.exe"
  SectionEnd
SectionGroupEnd

; PLUGIN_CHOICE records whether a plugin was chosen, and removes one that
; was left out, so a plugin unticked on an upgrade does not stay behind.
!macro PLUGIN_CHOICE SEC NAME FILE
  ${If} ${SectionIsSelected} ${SEC}
    WriteRegDWORD HKCU "${UNINST_KEY}" "Plugin.${NAME}" 1
  ${Else}
    Delete "$INSTDIR\${FILE}"
    WriteRegDWORD HKCU "${UNINST_KEY}" "Plugin.${NAME}" 0
  ${EndIf}
!macroend

; The last steps, once every chosen file is in place.
Section "-finish"
  !insertmacro PLUGIN_CHOICE ${SecGh} "gh" "kalka-plugin-gh.exe"
  !insertmacro PLUGIN_CHOICE ${SecJira} "jira" "kalka-plugin-jira.exe"
  nsExec::ExecToLog '"$INSTDIR\kalka.exe" path add'
  Pop $0
  ${If} $0 != 0
    MessageBox MB_OK|MB_ICONINFORMATION "${PATH_BY_HAND}" /SD IDOK
  ${EndIf}
  Call CheckWebView2
  ; After a silent update there is no finish page to start kalka from.
  ${If} ${Silent}
    Exec '"$INSTDIR\kalka-desktop.exe"'
  ${EndIf}
SectionEnd

!insertmacro MUI_FUNCTION_DESCRIPTION_BEGIN
  !insertmacro MUI_DESCRIPTION_TEXT ${SecCore} "kalka itself: the desktop app and the kalka command."
  !insertmacro MUI_DESCRIPTION_TEXT ${SecPlugins} "Plugins link blueprints to issue trackers. Each is optional."
  !insertmacro MUI_DESCRIPTION_TEXT ${SecGh} "gh: links to GitHub issues and pull requests. Needs the GitHub CLI (gh), logged in."
  !insertmacro MUI_DESCRIPTION_TEXT ${SecJira} "jira: links to Jira issues, their status and parents, and export of released versions. Set up in kalka's Settings."
!insertmacro MUI_FUNCTION_DESCRIPTION_END

; PLUGIN_REMEMBERED unticks a plugin the last install left out. One never
; chosen or refused before (a first install, or a plugin new in this
; release) stays ticked.
!macro PLUGIN_REMEMBERED SEC NAME
  ClearErrors
  ReadRegDWORD $0 HKCU "${UNINST_KEY}" "Plugin.${NAME}"
  ${IfNot} ${Errors}
  ${AndIf} $0 == 0
    !insertmacro UnselectSection ${SEC}
  ${EndIf}
!macroend

Function .onInit
  !insertmacro PLUGIN_REMEMBERED ${SecGh} "gh"
  !insertmacro PLUGIN_REMEMBERED ${SecJira} "jira"
FunctionEnd

; CheckWebView2 offers the runtime's download page when it is missing
; (spec 23.2). kalka works without it, in the browser.
Function CheckWebView2
  ReadRegStr $0 HKLM "SOFTWARE\WOW6432Node\${WV2_CLIENT}" "pv"
  ${If} $0 == ""
  ${OrIf} $0 == "0.0.0.0"
    ReadRegStr $0 HKCU "Software\${WV2_CLIENT}" "pv"
  ${EndIf}
  ${If} $0 == ""
  ${OrIf} $0 == "0.0.0.0"
    MessageBox MB_YESNO|MB_ICONEXCLAMATION "kalka's window needs the Microsoft Edge WebView2 runtime, which is not installed.$\r$\n$\r$\nOpen its download page now? Without it, kalka still works in your browser." /SD IDNO IDNO +2
    ExecShell "open" "[[.WebView2]]"
  ${EndIf}
FunctionEnd

; AddSamples runs `kalka samples`: it copies them into Personal, or, before
; setup, has them added once kalka is set up. Files already there are kept.
Function AddSamples
  nsExec::Exec '"$INSTDIR\kalka.exe" samples'
  Pop $0
  ${If} $0 != 0
    MessageBox MB_OK|MB_ICONINFORMATION "The sample blueprints could not be added. Run kalka samples in a terminal, or use Add sample blueprints in kalka's Settings."
  ${EndIf}
FunctionEnd

Section "Uninstall"
  DetailPrint "Stopping kalka"
  nsExec::Exec '"$INSTDIR\kalka.exe" stop --wait 30s'
  Pop $0
  nsExec::Exec '"$INSTDIR\kalka.exe" autostart off'
  Pop $0
  ; Before kalka.exe is removed: it is what takes the folder out of PATH.
  nsExec::ExecToLog '"$INSTDIR\kalka.exe" path remove'
  Pop $0
  ${If} $0 != 0
    DetailPrint "PATH not changed; remove $INSTDIR from it yourself if it is there"
  ${EndIf}
  Delete "$SMPROGRAMS\kalka.lnk"
  Delete "$INSTDIR\kalka.exe"
  Delete "$INSTDIR\kalka-desktop.exe"
  Delete "$INSTDIR\kalka-plugin-gh.exe"
  Delete "$INSTDIR\kalka-plugin-jira.exe"
  Delete "$INSTDIR\README.txt"
  Delete "$INSTDIR\uninstall.exe"
  RMDir "$INSTDIR"
  DeleteRegKey HKCU "${UNINST_KEY}"
  DeleteRegKey HKCU "Software\Classes\kalka"
  ; Your settings, keys and team logs stay in %APPDATA%\kalka; your
  ; blueprints stay in their folder.
  DetailPrint "Kept your settings and keys in $APPDATA\kalka"
SectionEnd
